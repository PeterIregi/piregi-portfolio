# Supabase Postgres connection string (dev project for local/preview, separate production project for deploys)
DATABASE_URL=

# Supabase project URL and service role key (server-only; never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string for signing Auth.js session cookies (openssl rand -base64 32)
AUTH_SECRET=

# Lets Auth.js accept the request Host header. Required for `pnpm build && pnpm start`
# on any host other than Vercel: without it every /api/auth/* endpoint 500s with
# UntrustedHost and the login page looks broken. Vercel sets VERCEL=1, which Auth.js
# reads instead, so this is local only and absent from .env.production.example
# (design.md §8).
AUTH_TRUST_HOST=true

# Resend API key; optional in dev, email then logs to console instead
RESEND_API_KEY=

# The inbox that receives contact-form submissions
CONTACT_NOTIFY_EMAIL=

# Canonical site origin, used for sitemap.xml, robots.txt, JSON-LD, and Open Graph URLs.
# Must include the scheme (https://piregi.dev). Not CMS content: it is deployment config.
NEXT_PUBLIC_SITE_URL=