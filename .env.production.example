# Production Environment Variables
# The authoritative list lives in render.yaml; this file documents what each
# one is for. Render stores the values, not this file.

# Build/runtime
NODE_VERSION=22
NEXT_TELEMETRY_DISABLED=1

# Auth.js trusts the Host header only when this is set or when it detects a
# known host platform. Vercel sets VERCEL=1 so this was Vercel-invisible;
# Render sets nothing Auth.js recognises, so without it every /api/auth/*
# request 500s with UntrustedHost and admin login appears broken.
AUTH_TRUST_HOST=true

# Canonical site origin (sitemap.xml, robots.txt, JSON-LD, Open Graph).
# Must include the scheme and match the domain actually served.
NEXT_PUBLIC_SITE_URL=https://piregi.dev

# Database (Supabase Production) - session pooler, port 5432, not the
# direct connection: Render opens a connection per deploy and the transient
# pool can exceed Supabase's direct-connection limit.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Production
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auth (generate: openssl rand -base64 32; render.yaml generates this)
AUTH_SECRET=your-32-char-production-secret-here

# Email (Resend). RESEND_API_KEY is optional; without it mail logs to console.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_NOTIFY_EMAIL=your-production@email.com

# Optional: Analytics, Sentry, etc.
# NEXT_PUBLIC_ANALYTICS_ID=
# SENTRY_DSN=